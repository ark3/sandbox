#!/usr/bin/env python3
"""Generic bubblewrap sandbox tool with auto-detection."""

import argparse
import os
import shlex
import shutil
import sys
import tempfile
from pathlib import Path

# Configuration
MARKER_FILES = [
    ".sandbox-workspace",
    ".sandbox-root",
    ".sandboxrc",
    ".workspace-root",
    "WORKSPACE",
]

COMMON_RW_MOUNTS = [
    "/tmp",
    "/var/tmp",
    "~/.cache",
    "~/.aider/caches",
    "~/.agents",
    "~/.aws/cli/cache",
    "~/.aws/sso/cache",
    "~/.bun/install/cache",
    "~/.config/agents",
    "~/.gradle/caches",
    "~/.npm",
    "~/.sonar/cache",
]

# Redirects, DEST -> SRC. See "Sandbox-private state" in the README for what
# these buy and what they cost.
#
# Choosing the mechanism for the next tool: prefer the tool's own configuration
# knob (see UV_TOOL_DIR in build_bwrap_command) over a redirect, because an env
# var announces itself to anyone debugging inside the sandbox while a redirect
# makes a path silently mean something else. Reach for a redirect when the path
# is a hardcoded convention with several consumers, or when the tool's knob is
# unreliable or unavailable. Maven qualifies on both counts: its only env knobs
# are MAVEN_OPTS (JVM flags -- clobbers heap settings) and MAVEN_ARGS (Maven
# 3.9+ only).
#
# Redirect the narrowest path that works: ~/.m2/settings.xml must stay readable
# or internal mirrors and credentials break.
REDIRECTS = {
    "~/.m2/repository": "~/.cache/agent-m2",
}

# Replaced with an empty tmpfs, with SSH_AUTH_SOCK unset alongside it. The
# threat model, the cost, and how to opt out are in the README's SSH section.
#
# A tmpfs rather than a bind of some empty directory, for two reasons that
# constrain any replacement: nothing is created on the host, so --dry-run stays
# free of side effects; and nothing left there survives the run.
SSH_DIR = "~/.ssh"

# Seeded into the masked ~/.ssh, where it is the only configuration ssh has --
# ~/.ssh/config is read before /etc/ssh/ssh_config and the first value of a
# keyword wins. All three directives are load-bearing; the README's SSH section
# says what each one defends against, so don't drop one without reading it.
# macOS cannot seed a file, so there these reach git as options instead -- see
# seatbelt_git_ssh_command.
SSH_CONFIG = """\
Host *
    BatchMode yes
    IdentitiesOnly yes
    ControlPath none
"""

# bwrap reads the seeded config from an inherited file descriptor. A fixed
# number keeps --dry-run output stable and quotable.
SSH_CONFIG_FD = 21

# Named sets of extra read-write mounts, selected by --profile or auto-detected
# from the command's basename. A profile decides only what is writable -- not
# what runs, and not which arguments get injected (see COMMAND_ARGS below).
PROFILE_MOUNTS = {
    "claude": [
        "~/.claude",
        "~/.claude.json",
    ],
    "codex": [
        "~/.codex",
    ],
    "opencode": [
        "~/.config/opencode",
        "~/.local/share/opencode",
        "~/.local/state/opencode",
    ],
    "pi": [
        "~/.pi",
    ],
    "omp": [
        "~/.omp",
        "~/.eclipse",
    ],
    "none": [],
}

# ACP adapters run their agent as a child inside the same sandbox, so each needs
# its agent's mounts. The names are irregular -- claude-agent-acp against
# codex-acp and pi-acp -- so matching is by literal entry, not by stripping a
# suffix.
#
# Copy, don't alias: each variant shares its agent's mounts today, but keeping
# a distinct list means a future per-variant mount edit can't silently mutate
# another entry.
PROFILE_MOUNTS["claude-agent-acp"] = list(PROFILE_MOUNTS["claude"])
PROFILE_MOUNTS["codex-acp"] = list(PROFILE_MOUNTS["codex"])
PROFILE_MOUNTS["pi-acp"] = list(PROFILE_MOUNTS["pi"])

# The union of every profile defined above. dict.fromkeys preserves profile and
# path order while collapsing overlaps such as the ACP variants' shared state.
PROFILE_MOUNTS["all"] = list(
    dict.fromkeys(path for mounts in PROFILE_MOUNTS.values() for path in mounts)
)

# Default arguments injected before the user's own, keyed by COMMAND NAME (not
# by --profile) -- see the README's "Command arguments" section.
#
# The -acp variants are intentionally absent even though they share their
# agent's mounts: an ACP adapter does not accept the agent's flags, so
# injecting them would break the command.
COMMAND_ARGS = {
    "claude": ["--permission-mode", "bypassPermissions"],
    "codex": ["--sandbox", "danger-full-access"],
}


def check_bubblewrap():
    if not shutil.which("bwrap"):
        print("Error: bubblewrap (bwrap) is not installed", file=sys.stderr)
        print("", file=sys.stderr)
        print("Install with:", file=sys.stderr)
        print("  sudo apt install bubblewrap    # Debian/Ubuntu", file=sys.stderr)
        print("  sudo dnf install bubblewrap    # Fedora", file=sys.stderr)
        print("  sudo pacman -S bubblewrap      # Arch", file=sys.stderr)
        sys.exit(1)


def check_sandbox_exec():
    if not Path("/usr/bin/sandbox-exec").is_file():
        print("Error: macOS sandbox-exec is not installed at /usr/bin/sandbox-exec", file=sys.stderr)
        sys.exit(1)


def find_workspace_via_markers(start_path: Path) -> Path | None:
    current = start_path.resolve()

    while True:
        for marker in MARKER_FILES:
            marker_path = current / marker
            if marker_path.exists():
                return current

        parent = current.parent
        if parent == current:  # Reached root
            return None
        current = parent


def find_workspace_via_git(start_path: Path) -> Path | None:
    """Walk up directory tree to find outermost git root."""
    current = start_path.resolve()
    outermost_git_root = None

    while True:
        git_dir = current / ".git"
        if git_dir.exists():
            outermost_git_root = current

        parent = current.parent
        if parent == current:  # Reached root
            break
        current = parent

    return outermost_git_root


def resolve_workspace(
    explicit_workspace: Path | None, work_dir: Path
) -> tuple[Path, Path]:
    """Resolve the sandbox workspace root and work_dir's path relative to it.

    Detection order: an explicit ``--workspace``, then a marker file, then the
    outermost git root. Exits with a diagnostic if no workspace can be found,
    or if work_dir is not inside the resolved workspace. Returns the resolved
    ``(workspace, rel_path)``, where ``rel_path`` is ``Path(".")`` when work_dir
    is the workspace root itself.
    """
    if explicit_workspace is not None:
        workspace = explicit_workspace.resolve()
        if not workspace.exists():
            print(f"Error: Workspace path does not exist: {workspace}", file=sys.stderr)
            sys.exit(1)
    else:
        workspace = find_workspace_via_markers(work_dir)
        if not workspace:
            workspace = find_workspace_via_git(work_dir)

    if not workspace:
        print("Error: Could not detect workspace", file=sys.stderr)
        print("", file=sys.stderr)
        print("Workspace detection attempts (in order):", file=sys.stderr)
        print(f"  1. --workspace flag (not provided)", file=sys.stderr)
        print(f"  2. Marker files {MARKER_FILES} (not found)", file=sys.stderr)
        print(f"  3. Git repository root (not found)", file=sys.stderr)
        print("", file=sys.stderr)
        print("Solutions:", file=sys.stderr)
        print("  - Run from within a git repository", file=sys.stderr)
        print("  - Create a marker file (e.g., .sandbox-workspace)", file=sys.stderr)
        print("  - Use --workspace /path/to/workspace", file=sys.stderr)
        sys.exit(1)

    try:
        rel_path = work_dir.resolve().relative_to(workspace.resolve())
    except ValueError:
        print(f"Error: Current directory must be under workspace", file=sys.stderr)
        print(f"  Workspace: {workspace}", file=sys.stderr)
        print(f"  Current:   {work_dir.resolve()}", file=sys.stderr)
        sys.exit(1)

    return workspace, rel_path


def resolve_profile(explicit_profile: str | None, command_name: str) -> str:
    """Resolve which mount profile to apply, given the command's basename."""
    if explicit_profile:
        return explicit_profile

    if command_name in PROFILE_MOUNTS:
        return command_name

    # Not recognized. The command itself is fine -- sbox just has no mount
    # profile for it, and won't guess which extra paths it should be able to
    # write.
    print(f"Error: No mount profile for '{command_name}'", file=sys.stderr)
    print("", file=sys.stderr)
    print(f"Available profiles: {', '.join(PROFILE_MOUNTS.keys())}", file=sys.stderr)
    print("", file=sys.stderr)
    # The suggestions name the flag rather than a whole command line: sbox
    # matches on the basename, so echoing it back would hand you a command that
    # runs something other than what you typed.
    print("Solutions:", file=sys.stderr)
    print("  - Run with no extra mounts: add --profile none", file=sys.stderr)
    print("  - Borrow another tool's mounts: add --profile codex", file=sys.stderr)
    print(f"  - Add '{command_name}' to PROFILE_MOUNTS in {__file__}", file=sys.stderr)
    sys.exit(1)


def create_redirect_dirs():
    """Create both ends of every redirect on the host.

    bwrap needs the source to exist to bind it, and needs the destination to
    exist as a mount point -- with ``--ro-bind / /`` it cannot create one on the
    read-only root. This is the only place sbox writes outside the sandbox, so
    it is kept off the --dry-run path; a dry-run command pasted into a shell may
    need these directories created first.
    """
    for dest_spec, src_spec in REDIRECTS.items():
        Path(os.path.expanduser(src_spec)).mkdir(parents=True, exist_ok=True)
        Path(os.path.expanduser(dest_spec)).mkdir(parents=True, exist_ok=True)


def ssh_config_is_seeded(expose_ssh: bool) -> bool:
    """Whether this run seeds a config into a masked ~/.ssh.

    True only when the mask applies and there is a ~/.ssh to mask -- the same
    condition build_bwrap_command uses to emit the --ro-bind-data that reads
    SSH_CONFIG_FD. The descriptor setup and the --dry-run note both key off
    this, so neither can drift from the command actually built.
    """
    return not expose_ssh and expand_and_validate_path(SSH_DIR) is not None


def open_ssh_config_fd():
    """Publish SSH_CONFIG on SSH_CONFIG_FD for bwrap's --ro-bind-data to read.

    The descriptor has to survive execvp, so it is duplicated onto a fixed
    number with the inheritable flag set. Writing before bwrap exists to read
    cannot block: the config is far smaller than a pipe buffer.
    """
    read_fd, write_fd = os.pipe()
    os.write(write_fd, SSH_CONFIG.encode())
    os.close(write_fd)
    os.dup2(read_fd, SSH_CONFIG_FD, inheritable=True)
    if read_fd != SSH_CONFIG_FD:
        os.close(read_fd)
    os.set_inheritable(SSH_CONFIG_FD, True)


def expand_and_validate_path(path_str: str) -> Path | None:
    """Expand ~ and env vars, return Path if exists, None otherwise."""
    expanded = os.path.expanduser(os.path.expandvars(path_str))
    path = Path(expanded)
    return path if path.exists() else None


def resolve_mount_paths(path_specs: list[str], warning_kind: str) -> list[Path]:
    """Resolve existing configured mount paths, preserving their declared order."""
    paths = []
    for path_spec in path_specs:
        path = expand_and_validate_path(path_spec)
        if path:
            paths.append(path)
        else:
            print(f"Warning: {warning_kind} not found, skipping: {path_spec}", file=sys.stderr)
    return paths


def resolve_rw_paths(rw_paths: list[str]) -> list[Path]:
    """Resolve explicit writable paths, which are errors rather than optional mounts."""
    paths = []
    for rw_path in rw_paths:
        path = expand_and_validate_path(rw_path)
        if path:
            paths.append(path)
        else:
            print(f"Error: --rw path not found: {rw_path}", file=sys.stderr)
            sys.exit(1)
    return paths


def build_bwrap_command(
    workspace: Path,
    profile: str,
    rw_paths: list[str],
    expose_ssh: bool,
    work_dir: Path,
    command: str,
    args: list[str],
) -> list[str]:
    cmd = ["bwrap"]

    # Base sandbox: environment, read-only root, and the writable workspace.
    # UV_TOOL_DIR is sandbox-private storage via the tool's own knob rather than
    # a redirect -- see REDIRECTS for when to use which.
    cmd.extend(["--setenv", "SBOX", "1"])
    cmd.extend(["--setenv", "UV_TOOL_DIR", os.path.expanduser("~/.cache/agent-uv-tools")])
    cmd.extend(["--ro-bind", "/", "/"])
    cmd.extend(["--dev", "/dev"])
    cmd.extend(["--proc", "/proc"])
    cmd.extend(["--bind", str(workspace), str(workspace)])

    # Profile mounts
    for path in resolve_mount_paths(PROFILE_MOUNTS[profile], "Profile mount path"):
        cmd.extend(["--bind", str(path), str(path)])

    # Common read-write mounts
    for path in resolve_mount_paths(COMMON_RW_MOUNTS, "Common mount path"):
        cmd.extend(["--bind", str(path), str(path)])

    # Redirects. After the common mounts, so an entry above cannot re-expose a
    # slice of the real directory on top of the redirect, and before --rw, so an
    # explicit user mount still wins. Emitted whether or not the paths exist:
    # create_redirect_dirs() makes them on the way to exec, and --dry-run should
    # still show the redirect it would apply.
    for dest_spec, src_spec in REDIRECTS.items():
        dest = os.path.expanduser(dest_spec)
        src = os.path.expanduser(src_spec)
        cmd.extend(["--bind", src, dest])

    # SSH masking. After the redirects and before --rw, so `--rw ~/.ssh` can
    # still put the real directory back for a run that genuinely needs it. The
    # tmpfs needs an existing mount point, which a read-only root cannot
    # supply, so a missing ~/.ssh is skipped -- there is nothing to hide. The
    # agent socket is dropped either way: it can carry usable keys even when no
    # key file exists on disk.
    if not expose_ssh:
        ssh_dir = expand_and_validate_path(SSH_DIR)
        if ssh_dir:
            cmd.extend(["--tmpfs", str(ssh_dir)])
            # --ro-bind-data rather than --file: --file creates the config
            # 0666 whatever the umask, and ssh refuses a group- or
            # world-writable config outright. --perms 0600 would fix that but
            # needs bwrap 0.5+ (Ubuntu 20.04 still ships 0.4). --ro-bind-data
            # lands it 0600 on every version, and because the file is a mount
            # point the sandbox can neither rewrite nor unlink it -- unlink
            # returns EBUSY -- so the settings hold for the whole run.
            cmd.extend(
                ["--ro-bind-data", str(SSH_CONFIG_FD), str(ssh_dir / "config")]
            )
        cmd.extend(["--unsetenv", "SSH_AUTH_SOCK"])

    # Ad-hoc read-write mounts
    for path in resolve_rw_paths(rw_paths):
        cmd.extend(["--bind", str(path), str(path)])

    # Isolation, then where and what to run.
    cmd.extend(["--unshare-all"])
    cmd.extend(["--share-net"])
    cmd.extend(["--die-with-parent"])
    cmd.extend(["--chdir", str(work_dir)])
    cmd.append(command)
    cmd.extend(args)

    return cmd


def seatbelt_git_ssh_command() -> str:
    """SSH_CONFIG as ssh options, for git to use in place of a seeded config.

    Seatbelt can hide ~/.ssh but cannot put a seeded config in it, so only
    commands that honor GIT_SSH_COMMAND get these directives. -F /dev/null keeps
    every config file out. UserKnownHostsFile /dev/null stops ssh from trying
    the hidden known_hosts, and costs nothing: BatchMode refuses unknown hosts
    rather than recording them, so a writable file would only ever stay empty.
    """
    options = ["-F", "/dev/null", "-o", "UserKnownHostsFile=/dev/null"]
    for line in SSH_CONFIG.splitlines()[1:]:
        options += ["-o", "=".join(line.split())]
    return shlex.join(["ssh", *options])


def build_seatbelt_command(
    workspace: Path,
    profile: str,
    rw_paths: list[str],
    expose_ssh: bool,
    command: str,
    args: list[str],
) -> list[str]:
    """Build an allow-by-default Seatbelt invocation that denies host writes."""
    parameters: list[str] = []
    parameter_number = 0

    def add_path_parameter(prefix: str, path: Path) -> str:
        # A policy with an interpolated pathname is both hard to quote and easy
        # to get subtly wrong. Seatbelt receives only canonical paths through
        # -D, so symlinks such as /tmp cannot bypass a matching rule.
        nonlocal parameter_number
        name = f"{prefix}_{parameter_number}"
        parameter_number += 1
        parameters.extend(["-D", f"{name}={path.resolve()}"])
        return name

    policy = ["(version 1)", "(allow default)", "(deny file-write*)"]

    def allow_write(prefix: str, path: Path):
        name = add_path_parameter(prefix, path)
        policy.append(f'(allow file-write* (subpath (param "{name}")))')

    # Keep these path sets in the same order and with the same missing-path
    # behavior as bwrap. Seatbelt has no mounts, but the write surface must be
    # precisely the one the Linux backend creates.
    allow_write("WORKSPACE", workspace)
    for path in resolve_mount_paths(PROFILE_MOUNTS[profile], "Profile mount path"):
        allow_write("PROFILE", path)
    for path in resolve_mount_paths(COMMON_RW_MOUNTS, "Common mount path"):
        allow_write("COMMON", path)
    allow_write("TMPDIR", Path(tempfile.gettempdir()))
    policy.append("(allow file-write* (vnode-type CHARACTER-DEVICE))")

    if not expose_ssh:
        # Denying the real directory, not the spelling through ~/.ssh, matters
        # because Seatbelt follows symlinks before comparing a rule.
        ssh_dir = Path(os.path.expanduser(os.path.expandvars(SSH_DIR)))
        ssh_name = add_path_parameter("SSH_DIR", ssh_dir)
        policy.append(f'(deny file-read* (subpath (param "{ssh_name}")))')

        # The agent socket is denied by location, not just dropped from the
        # environment, so a child that finds it again still cannot connect.
        # launchd's agent is matched by pattern, which holds even when
        # SSH_AUTH_SOCK is unset; any other agent only by the path it names.
        policy.append(
            "(deny network-outbound (remote unix-socket (path-regex"
            r' #"^/private/tmp/com\.apple\.launchd\.[^/]+/Listeners$")))'
        )
        if os.environ.get("SSH_AUTH_SOCK"):
            socket_name = add_path_parameter(
                "SSH_AUTH_SOCK", Path(os.environ["SSH_AUTH_SOCK"])
            )
            policy.append(
                "(deny network-outbound (remote unix-socket"
                f' (path-literal (param "{socket_name}"))))'
            )

    # Escape-hatch friction, not a containment guarantee. launchctl submit and
    # bootstrap fail under this policy as a whole, but which rule stops them was
    # never isolated; see the README's macOS section.
    policy.append("(deny appleevent-send)")
    policy.append(
        '(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd"))'
    )

    # These come last: in particular, --rw ~/.ssh deliberately re-allows reads
    # after the default SSH mask as well as making the directory writable.
    for path in resolve_rw_paths(rw_paths):
        name = add_path_parameter("RW", path)
        policy.append(f'(allow file-read* (subpath (param "{name}")))')
        policy.append(f'(allow file-write* (subpath (param "{name}")))')

    return [
        "/usr/bin/sandbox-exec",
        *parameters,
        "-p",
        "\n".join(policy),
        command,
        *args,
    ]


def seatbelt_environment(expose_ssh: bool) -> dict[str, str]:
    """Variables sbox sets for the command; SSH_AUTH_SOCK is unset separately."""
    environment = {
        "SBOX": "1",
        "UV_TOOL_DIR": str(Path(os.path.expanduser("~/.cache/agent-uv-tools")).resolve()),
    }
    if not expose_ssh:
        environment["GIT_SSH_COMMAND"] = seatbelt_git_ssh_command()
    return environment


def seatbelt_shell_command(
    command: list[str], environment: dict[str, str], unset_ssh_auth_sock: bool
) -> list[str]:
    """Make --dry-run's environment visible and directly reproducible in a shell."""
    shell_command = ["/usr/bin/env"]
    if unset_ssh_auth_sock:
        shell_command.extend(["-u", "SSH_AUTH_SOCK"])
    shell_command.extend(f"{name}={value}" for name, value in environment.items())
    return shell_command + command


def run_directly(
    command: str, command_args: list[str], args: argparse.Namespace
) -> int:
    """Run the command in place of a nested sandbox, for pass-through.

    The cwd and environment are inherited unchanged; sandbox options cannot
    alter the existing session's access, so any that were given are named as
    ignored rather than silently dropped. Returns only on --dry-run or failure.
    """
    print("sbox: passing through inside existing session", file=sys.stderr)
    ignored = [
        flag
        for flag, given in [
            ("--workspace", args.workspace is not None),
            ("--profile", args.profile is not None),
            ("--rw", bool(args.rw)),
            ("--ssh" if args.ssh else "--no-ssh", args.ssh is not None),
        ]
        if given
    ]
    if ignored:
        print(
            f"sbox: ignoring {', '.join(ignored)}:"
            " the existing session's access applies",
            file=sys.stderr,
        )
    direct_cmd = [command, *command_args]
    if args.dry_run:
        print(shlex.join(direct_cmd))
        return 0
    try:
        os.execvp(command, direct_cmd)
    except FileNotFoundError:
        print(f"Error: Command not found: {command}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"Error: Cannot execute {command}: {e.strerror}", file=sys.stderr)
        return 1


def main():
    parser = argparse.ArgumentParser(
        usage="%(prog)s [OPTIONS] COMMAND [ARGS...]",
        description="Run commands in a bubblewrap sandbox with workspace isolation",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
The first bare word is the COMMAND; everything after it is passed through to
the command untouched, so the command's own flags need no `--` guard.

A --profile selects extra writable paths only; it does not decide what runs.
Sandbox-disabling flags are injected based on the COMMAND, so a shell run under
a tool's profile stays a plain shell.

Examples:
  sbox claude --resume UUID                # Flags after the command pass through
  sbox --profile none bash                 # No profile mounts
  sbox --profile codex bash                # Codex's mounts, plain shell, no injection
  sbox --workspace /path bash              # Explicit workspace
  sbox --ssh --profile none git push       # Expose the real ~/.ssh and agent
  sbox --rw ~/.cargo --profile none build  # Additional read-write mount
  sbox -- --weird-command                  # `--` still works as a hard separator
        """,
    )
    parser.add_argument("--workspace", type=Path, help="Explicit workspace path")
    parser.add_argument(
        "--profile",
        choices=list(PROFILE_MOUNTS.keys()),
        # An explicit metavar keeps --help to one copy of the choices list.
        metavar="NAME",
        help="Mount profile to apply: " + ", ".join(PROFILE_MOUNTS),
    )
    # --tool was this option's original name. Kept working so existing shell
    # aliases and history don't break, but deliberately silent: undocumented,
    # absent from --help, and not pinned by a test, so it can be deleted
    # whenever it stops earning its keep.
    parser.add_argument(
        "--tool",
        dest="profile",
        choices=list(PROFILE_MOUNTS.keys()),
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--rw",
        action="append",
        default=[],
        help="Additional read-write mount (repeatable)",
    )
    parser.add_argument(
        "--ssh",
        action=argparse.BooleanOptionalAction,
        # None, not False, so pass-through can tell --no-ssh from no flag.
        default=None,
        help="Expose the real ~/.ssh and ssh-agent (default: an empty directory)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print bwrap command instead of executing",
    )
    parser.add_argument("command", help="Command to run")
    # REMAINDER stops option parsing at the command, so every token after it is
    # captured verbatim -- the command's own flags are never mistaken for
    # sbox's, and no `--` guard is required.
    parser.add_argument(
        "args", nargs=argparse.REMAINDER, help="Arguments passed to the command"
    )

    args = parser.parse_args()
    command, command_args = args.command, args.args

    # A command is identified by its basename, derived once and used for both
    # lookups below so the two cannot disagree about what is being run: an
    # absolute path to a tool still resolves that tool's profile, and a wrapper
    # command (a shell, make, env ...) run under a tool's profile still never
    # receives that tool's flags.
    command_name = Path(command).name

    # Injected before the user's own arguments, so a user-supplied value of the
    # same flag wins; log exactly what we add.
    injected = COMMAND_ARGS.get(command_name, [])
    if injected:
        print(
            f"sbox: adding {command_name} args: {' '.join(injected)}", file=sys.stderr
        )
    command_args = injected + command_args

    # Both must be exactly "1": opting in outside sbox must still create a
    # sandbox. SBOX is an inherited marker, not a containment verification.
    if (
        os.environ.get("SBOX") == "1"
        and os.environ.get("DANGER_SBOX_PASS_THROUGH") == "1"
    ):
        return run_directly(command, command_args, args)
    # Past pass-through, an absent --ssh means the default: not exposed.
    args.ssh = bool(args.ssh)

    is_macos = sys.platform == "darwin"
    if is_macos:
        check_sandbox_exec()
    else:
        check_bubblewrap()

    work_dir = Path.cwd()
    workspace, rel_path = resolve_workspace(args.workspace, work_dir)
    profile = resolve_profile(args.profile, command_name)

    if is_macos:
        sandbox_cmd = build_seatbelt_command(
            workspace, profile, args.rw, args.ssh, command, command_args
        )
        overrides = seatbelt_environment(args.ssh)

        if args.dry_run:
            shell_cmd = seatbelt_shell_command(sandbox_cmd, overrides, not args.ssh)
            print(shlex.join(shell_cmd))
            return 0

        # macOS has no bind mounts, so there are no redirect directories to
        # create: this backend writes nothing on the host.
        environment = {**os.environ, **overrides}
        if not args.ssh:
            environment.pop("SSH_AUTH_SOCK", None)
    else:
        sandbox_cmd = build_bwrap_command(
            workspace, profile, args.rw, args.ssh, work_dir, command, command_args
        )
        environment = dict(os.environ)

        if args.dry_run:
            print(" ".join(sandbox_cmd))
            if ssh_config_is_seeded(args.ssh):
                print(
                    f"sbox: fd {SSH_CONFIG_FD} carries the seeded ~/.ssh/config; the"
                    f" printed command needs it redirected to run by hand",
                    file=sys.stderr,
                )
            return 0

        create_redirect_dirs()

        # Only when the command actually reads it -- an unopened SSH_CONFIG_FD
        # would make bwrap fail on a descriptor that isn't there.
        if ssh_config_is_seeded(args.ssh):
            open_ssh_config_fd()

    if rel_path == Path("."):
        print(f"sbox [{profile}]: {workspace}", file=sys.stderr)
    else:
        print(f"sbox [{profile}]: {workspace} ({rel_path})", file=sys.stderr)

    try:
        # Replace this process with the sandbox; main() does not return on
        # success. sandbox-exec is named by absolute path, so PATH cannot choose
        # a different sandbox implementation on macOS.
        os.execvpe(sandbox_cmd[0], sandbox_cmd, environment)
    except FileNotFoundError:
        print(
            f"Error: Failed to execute {sandbox_cmd[0]}"
            " (this should not happen after check)",
            file=sys.stderr,
        )
        return 1
    # unreachable


if __name__ == "__main__":
    sys.exit(main())
